# Shared secret used to sign/verify JWTs. Every service (gateway + all
# downstream services) MUST use the exact same value.
SECRET_KEY=change-me-to-a-long-random-string

# Shared secret used for service-to-service calls that are not
# authenticated with a user JWT (e.g. gateway -> like-service cascade
# delete on comment deletion).
INTERNAL_SERVICE_SECRET=change-me-too

# --- user-service / avatar storage (S3-compatible, e.g. LocalStack) ---
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=cloud-social-platform-media
PUBLIC_S3_BASE_URL=http://localhost:4566/cloud-social-platform-media

# --- gateway ---
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=memory
GATEWAY_RETRY_ATTEMPTS=2
GATEWAY_RETRY_BACKOFF_SECONDS=0.15
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=10
MAX_REQUEST_BODY_SIZE_BYTES=3145728
LOG_LEVEL=INFO

AUTH_SERVICE_URL=http://auth-service:8000
USER_SERVICE_URL=http://user-service:8000
POST_SERVICE_URL=http://post-service:8000
LIKE_SERVICE_URL=http://like-service:8000
FOLLOW_SERVICE_URL=http://follow-service:8000
COMMENT_SERVICE_URL=http://comment-service:8000

# Comma-separated browser origins allowed to call the gateway directly
# (only needed if the frontend does NOT use the Vite /api proxy).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: LocalStack profile and local Grafana dashboard
LOCALSTACK_AUTH_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-before-exposing-grafana
RATE_LIMIT_KEY_PREFIX=gateway:rate_limit
